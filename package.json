{
  "name": "somtoday-mcp",
  "version": "0.1.0",
  "description": "Unofficial read-only MCP server for the Somtoday parent portal",
  "type": "module",
  "bin": {
    "somtoday-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "ouder-portal.openapi.yaml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "tsc --noEmit && vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barzoj/somtoday-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "somtoday",
    "ouderportaal",
    "school",
    "homework",
    "timetable",
    "grades"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/barzoj/somtoday-mcp/issues"
  },
  "homepage": "https://github.com/barzoj/somtoday-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "playwright": "^1.56.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
