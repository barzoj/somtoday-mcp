{
  "name": "somtoday-mcp",
  "version": "0.1.1",
  "description": "Unofficial read-only MCP server for the Somtoday parent portal",
  "type": "module",
  "bin": {
    "somtoday-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "ouder-portal.openapi.yaml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "smoke:live": "node scripts/live-smoke.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barzoj/somtoday-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "somtoday",
    "ouderportaal",
    "school",
    "homework",
    "timetable",
    "grades"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/barzoj/somtoday-mcp/issues"
  },
  "homepage": "https://github.com/barzoj/somtoday-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "playwright": "^1.64.1",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.8",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
